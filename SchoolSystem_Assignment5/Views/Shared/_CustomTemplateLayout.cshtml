<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EduAdmin Portal</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/custom-template.css" />
</head>
<body>
    <div class="template-wrapper">
        <!-- Sidebar -->
        <aside class="template-sidebar">
            <a class="brand" asp-controller="Student" asp-action="Index">EduAdmin Pro</a>
            <nav class="mt-3">
                <a class="nav-link" asp-controller="Student" asp-action="Index">Students Index (Template)</a>
                <a class="nav-link" asp-controller="Student" asp-action="GetAll">Students GetAll</a>
                <a class="nav-link" asp-controller="Student" asp-action="Add">Add Student</a>
                <a class="nav-link" asp-controller="Department" asp-action="ShowAll">Departments</a>
                <a class="nav-link" asp-controller="Department" asp-action="Add">Add Department</a>
            </nav>
        </aside>

        <!-- Main Area -->
        <div class="template-main">
            <header class="template-topbar">
                <span class="fw-semibold text-secondary">@ViewData["Title"]</span>
                <span class="badge bg-primary">ASP.NET Core 8.0 MVC</span>
            </header>

            <main class="template-content">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @RenderBody()
            </main>

            <footer class="template-footer">
                &copy; 2026 EduAdmin School Management System
            </footer>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
