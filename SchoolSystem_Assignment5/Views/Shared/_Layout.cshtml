<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SchoolSystem</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Student" asp-action="Index">SchoolSystem</a>
            <div class="navbar-nav">
                <a class="nav-link" asp-controller="Student" asp-action="Index">Students Index</a>
                <a class="nav-link" asp-controller="Student" asp-action="GetAll">Students GetAll</a>
                <a class="nav-link" asp-controller="Student" asp-action="Add">Add Student</a>
                <a class="nav-link" asp-controller="Department" asp-action="ShowAll">Departments</a>
                <a class="nav-link" asp-controller="Department" asp-action="Add">Add Department</a>
            </div>
        </div>
    </nav>
    <div class="container">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @RenderBody()
    </div>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
